
# registry.cn-hangzhou.aliyuncs.com/lpx03/xtrabackup:base-glib-2.28
# 构建示例:
#   docker build -f Dockerfile-glib2.28 -t xtrabackup:base-glib-2.28 .
#   # 国内构建用南大镜像加速:
#   docker build -f Dockerfile-glib2.28 --build-arg ZONE=cn -t xtrabackup:base-glib-2.28 .
#   # 内网走代理下载 patchelf:
#   docker build -f Dockerfile-glib2.28 --build-arg GH_PROXY=https://gh.1102345.xyz/ -t xtrabackup:base-glib-2.28 .
#   # 多架构(buildx 自动注入 TARGETARCH):
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile-glib2.28 -t xtrabackup:base-glib-2.28 .
#
# 可用 ARG:
#   ZONE             区域:空(默认)=官方源;cn=南大镜像源(国内加速)
#   GH_PROXY         GitHub 下载代理前缀,默认空(直连)。例:https://gh.1102345.xyz/
#   PATCHELF_VERSION patchelf 版本,默认 0.19.1
#   TARGETARCH       buildx 自动注入(amd64/arm64),无需手动传

FROM registry.cn-hangzhou.aliyuncs.com/lpx03/rockylinux:8.9.20231119

# buildx 多架构:TARGETARCH 由 buildx 自动注入(amd64/arm64)
ARG ZONE=""
ARG GH_PROXY=""
ARG PATCHELF_VERSION=0.19.1
ARG TARGETARCH

# ============================================================
# yum 源配置:ZONE=cn 用南大镜像(国内加速),否则用官方源
# ============================================================
# ZONE=cn 时把 Rocky 官方源替换为南大镜像(禁 mirrorlist,改 baseurl)
RUN if [ "${ZONE}" = "cn" ]; then \
        echo "==> [ZONE=cn] Rocky 源 -> 南大镜像"; \
        sed -i \
            -e 's|^mirrorlist=|#mirrorlist=|g' \
            -e 's|^#baseurl=http://dl.rockylinux.org/$contentdir|baseurl=https://mirror.nju.edu.cn/rocky|g' \
            /etc/yum.repos.d/Rocky-*.repo; \
    else \
        echo "==> [ZONE=默认] 使用 Rocky 官方源"; \
    fi

# 安装 EPEL。ZONE=cn 时同时把 EPEL 源替换为南大镜像
# (EPEL 提供 PowerTools 里部分包,PowerTools 通过下面 --enablerepo 启用)
RUN yum install -y epel-release && \
    if [ "${ZONE}" = "cn" ]; then \
        echo "==> [ZONE=cn] EPEL 源 -> 南大镜像"; \
        sed -i \
            -e 's|^metalink=|#metalink=|g' \
            -e 's|^#baseurl=|baseurl=|g' \
            -e 's|https\?://download\.fedoraproject\.org/pub/epel|https://mirror.nju.edu.cn/epel|g' \
            -e 's|https\?://download\.example/pub/epel|https://mirror.nju.edu.cn/epel|g' \
            /etc/yum.repos.d/epel.repo /etc/yum.repos.d/epel-testing.repo; \
    fi

# 安装编译依赖
RUN yum install -y procps-ng-devel --enablerepo=powertools && \
    yum install -y \
        autoconf \
        automake \
        bison \
        bzip2 \
        cmake \
        cyrus-sasl-devel \
        file \
        gcc-c++ \
        git \
        libaio \
        libaio-devel \
        libarchive \
        libcurl-devel \
        libev-devel \
        libgcrypt-devel \
        libgpg-error-devel \
        libicu-devel \
        libtool \
        libtirpc-devel \
        libudev-devel \
        libxml2-devel \
        libzstd-devel \
        lz4-devel \
        make \
        ncurses-devel \
        numactl-devel \
        openldap-devel \
        openssl-devel \
        patch \
        protobuf-compiler \
        readline-devel \
        vim-common \
        zlib-devel \
        zstd \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        gcc-toolset-12-binutils \
        gcc-toolset-12-annobin-annocheck \
        gcc-toolset-12-annobin-plugin-gcc && \
    yum clean all && \
    rm -rf /var/cache/yum

# 安装新版 patchelf。
# yum 源里的 patchelf 0.10 对 xtrabackup 这种 256-notes 的大 ELF 文件处理
# --force-rpath / --set-soname 会静默失败,必须用新版。
# 架构映射:docker 用 amd64/arm64,patchelf 包名用 x86_64/aarch64
RUN set -e && \
    case "$TARGETARCH" in \
        amd64)  PE_ARCH=x86_64  ;; \
        arm64)  PE_ARCH=aarch64 ;; \
        *)      PE_ARCH="$TARGETARCH" ;; \
    esac && \
    PE_URL="${GH_PROXY}https://github.com/NixOS/patchelf/releases/download/${PATCHELF_VERSION}/patchelf-${PATCHELF_VERSION}-${PE_ARCH}.tar.gz" && \
    echo "==> 下载 patchelf: $PE_URL" && \
    curl -sSL -o /tmp/patchelf.tar.gz "$PE_URL" && \
    tar -xzf /tmp/patchelf.tar.gz -C /tmp && \
    cp /tmp/bin/patchelf /usr/local/bin/patchelf && \
    chmod +x /usr/local/bin/patchelf && \
    rm -rf /tmp/patchelf* && \
    patchelf --version

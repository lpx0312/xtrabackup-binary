
# CentOS 7 glibc 2.17 编译环境镜像
# 构建示例:
#   docker build -f Dockerfile-glib2.17 -t xtrabackup:base-glib-2.17 .
#   # 国内构建用南大镜像加速:
#   docker build -f Dockerfile-glib2.17 --build-arg ZONE=cn -t xtrabackup:base-glib-2.17 .
#   # 内网走代理下载 patchelf:
#   docker build -f Dockerfile-glib2.17 --build-arg GH_PROXY=https://gh.1102345.xyz/ -t xtrabackup:base-glib-2.17 .
#   # 多架构(buildx 自动注入 TARGETARCH):
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile-glib2.17 -t xtrabackup:base-glib-2.17 .
#
# 可用 ARG:
#   ZONE             区域:空(默认)=vault.centos.org 官方存档;cn=南大镜像(国内加速)
#   GH_PROXY         GitHub 下载代理前缀,默认空(直连)。例:https://gh.1102345.xyz/
#   PATCHELF_VERSION patchelf 版本,默认 0.19.1
#   TARGETARCH       buildx 自动注入(amd64/arm64),无需手动传
# registry.cn-hangzhou.aliyuncs.com/lpx03/xtrabackup:base-glib-2.17
FROM centos:7.9.2009

# buildx 多架构:TARGETARCH 由 buildx 自动注入(amd64/arm64)
ARG ZONE=""
ARG GH_PROXY=""
ARG PATCHELF_VERSION=0.19.1
ARG TARGETARCH

# ============================================================
# yum 源修复:CentOS 7 已 EOL,镜像内官方源全部失效,必须改用存档源
# ZONE 控制用哪个存档:
#   默认(空) -> vault.centos.org 官方存档(海外 CI 用)
#   cn       -> mirror.nju.edu.cn 南大镜像(国内加速)
# amd64/arm64 路径不同,按 TARGETARCH 分流(arm64 走 altarch/):
#   amd64 -> <vault>/centos/7.9.2009/os/x86_64/
#   arm64 -> <vault>/altarch/7.9.2009/os/aarch64/
# 用 printf 重写 repo(比 sed 稳定,避开正则/转义坑)。
# gpgcheck 全部关闭(存档源 key 对不上,构建镜像场景可接受)。
# ============================================================
RUN set -e && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        if [ "${ZONE}" = "cn" ]; then \
            VAULT="https://mirror.nju.edu.cn/centos-vault/altarch"; \
        else \
            VAULT="https://vault.centos.org/altarch"; \
        fi; \
    else \
        if [ "${ZONE}" = "cn" ]; then \
            VAULT="https://mirror.nju.edu.cn/centos-vault/centos"; \
        else \
            VAULT="https://vault.centos.org/centos"; \
        fi; \
    fi && \
    printf '[base]\nname=CentOS-7 - Base\nbaseurl=%s/$releasever/os/$basearch/\ngpgcheck=0\n\n[updates]\nname=CentOS-7 - Updates\nbaseurl=%s/$releasever/updates/$basearch/\ngpgcheck=0\n\n[extras]\nname=CentOS-7 - Extras\nbaseurl=%s/$releasever/extras/$basearch/\ngpgcheck=0\n' \
        "$VAULT" "$VAULT" "$VAULT" > /etc/yum.repos.d/CentOS-Base.repo && \
    echo "==> [$TARGETARCH][ZONE=${ZONE:-default}] CentOS-Base -> ${VAULT}"

# Step B: 安装 EPEL + SCL 仓库,然后配置这两个源
# EPEL:ZONE=cn 用南大镜像,默认用 dl.fedoraproject.org 官方
# SCL: 与 base 同源(同一 VAULT 下的 sclo/ 子目录)
RUN set -e && \
    yum install -y epel-release centos-release-scl && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        if [ "${ZONE}" = "cn" ]; then \
            VAULT="https://mirror.nju.edu.cn/centos-vault/altarch"; \
        else \
            VAULT="https://vault.centos.org/altarch"; \
        fi; \
    else \
        if [ "${ZONE}" = "cn" ]; then \
            VAULT="https://mirror.nju.edu.cn/centos-vault/centos"; \
        else \
            VAULT="https://vault.centos.org/centos"; \
        fi; \
    fi && \
    if [ "${ZONE}" = "cn" ]; then \
        EPEL_BASE="https://mirror.nju.edu.cn/epel"; \
    else \
        EPEL_BASE="https://dl.fedoraproject.org/pub/epel"; \
    fi && \
    sed -i \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^metalink=|#metalink=|g' \
        -e "s|^#baseurl=.*download\.fedoraproject\.org/pub/epel\(.*\)|baseurl=${EPEL_BASE}\1|g" \
        -e "s|^# baseurl=.*download\.fedoraproject\.org/pub/epel\(.*\)|baseurl=${EPEL_BASE}\1|g" \
        -e 's|^gpgcheck=1|gpgcheck=0|g' \
        /etc/yum.repos.d/epel.repo /etc/yum.repos.d/epel-testing.repo && \
    printf '[centos-sclo-rh]\nname=CentOS-7 - SCLo rh\nbaseurl=%s/$releasever/sclo/$basearch/rh/\ngpgcheck=0\nenabled=1\n' \
        "$VAULT" > /etc/yum.repos.d/CentOS-SCLo-scl-rh.repo && \
    printf '[centos-sclo-sclo]\nname=CentOS-7 - SCLo sclo\nbaseurl=%s/$releasever/sclo/$basearch/sclo/\ngpgcheck=0\nenabled=1\n' \
        "$VAULT" > /etc/yum.repos.d/CentOS-SCLo-scl.repo && \
    echo "==> [$TARGETARCH][ZONE=${ZONE:-default}] SCLo/epel 源配置完成"

# ============================================================
# 安装全部编译依赖
# ============================================================
RUN yum install -y \
        autoconf \
        automake \
        bison \
        bzip2 \
        cmake3 \
        cyrus-sasl-devel \
        file \
        git \
        libaio \
        libaio-devel \
        libarchive \
        libcurl-devel \
        libev-devel \
        libgcrypt-devel \
        libgpg-error-devel \
        libicu-devel \
        libtool \
        libtirpc-devel \
        libudev-devel \
        libxml2-devel \
        lz4-devel \
        make \
        ncurses-devel \
        numactl-devel \
        openldap-devel \
        openssl-devel \
        patch \
        procps-ng-devel \
        readline-devel \
        vim-common \
        zlib-devel \
        zstd && \
    # devtoolset 按 TARGETARCH 分流:
    #   amd64 -> devtoolset-11(GCC 11.2.1)
    #   arm64 -> devtoolset-10(GCC 10.2.1;aarch64 的 SCL 无 devtoolset-11-gcc 本体)
    if [ "$TARGETARCH" = "arm64" ]; then \
        DTS=10; \
    else \
        DTS=11; \
    fi && \
    yum install -y \
        devtoolset-${DTS}-gcc \
        devtoolset-${DTS}-gcc-c++ \
        devtoolset-${DTS}-binutils \
        devtoolset-${DTS}-annobin && \
    yum clean all && \
    rm -rf /var/cache/yum

# 安装新版 patchelf。
# yum/epel 源里的 patchelf 太老(0.x),对 xtrabackup 这种 256-notes 大 ELF
# 处理 --force-rpath / --set-soname 会静默失败,必须用新版。
# 架构映射:docker 用 amd64/arm64,patchelf 包名用 x86_64/aarch64
RUN set -e && \
    case "$TARGETARCH" in \
        amd64)  PE_ARCH=x86_64  ;; \
        arm64)  PE_ARCH=aarch64 ;; \
        *)      PE_ARCH="$TARGETARCH" ;; \
    esac && \
    PE_URL="${GH_PROXY}https://github.com/NixOS/patchelf/releases/download/${PATCHELF_VERSION}/patchelf-${PATCHELF_VERSION}-${PE_ARCH}.tar.gz" && \
    echo "==> 下载 patchelf: $PE_URL" && \
    curl -sSL -o /tmp/patchelf.tar.gz "$PE_URL" && \
    tar -xzf /tmp/patchelf.tar.gz -C /tmp && \
    cp /tmp/bin/patchelf /usr/local/bin/patchelf && \
    chmod +x /usr/local/bin/patchelf && \
    rm -rf /tmp/patchelf* && \
    patchelf --version

# cmake 软链 -> cmake3（兼容构建脚本直接调 cmake）
RUN ln -sf /usr/bin/cmake3 /usr/local/bin/cmake

# 全局启用 devtoolset(amd64=11 / arm64=10)。
# DTS 版本由实际安装的目录决定,然后建统一软链 /opt/rh/devtoolset -> devtoolset-{10,11},
# 这样下面的 ENV 和运行时 source 路径在两个架构上完全一致,无需按架构分支。
RUN set -e && \
    if   [ -d /opt/rh/devtoolset-11 ]; then DTS=11; \
    elif [ -d /opt/rh/devtoolset-10 ]; then DTS=10; \
    else echo "ERROR: 未找到 devtoolset 目录"; exit 1; fi && \
    ln -sf "devtoolset-${DTS}" /opt/rh/devtoolset && \
    echo "source /opt/rh/devtoolset/enable" > /etc/profile.d/devtoolset.sh && \
    echo "source /opt/rh/devtoolset/enable" >> /etc/bashrc && \
    echo "==> 全局启用 devtoolset-${DTS} (统一软链 /opt/rh/devtoolset)"

ENV CC=/opt/rh/devtoolset/root/usr/bin/gcc \
    CXX=/opt/rh/devtoolset/root/usr/bin/g++ \
    FC=/opt/rh/devtoolset/root/usr/bin/gfortran

# CentOS 7 glibc 版本
RUN ldd --version | head -1

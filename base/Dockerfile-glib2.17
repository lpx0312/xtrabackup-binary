
# CentOS 7 glibc 2.17 编译环境镜像
# 构建示例:
#   docker build -f Dockerfile-glib2.17 -t xtrabackup:base-glib-2.17 .
#   # 内网走代理下载 patchelf:
#   docker build -f Dockerfile-glib2.17 --build-arg GH_PROXY=https://gh.1102345.xyz/ -t xtrabackup:base-glib-2.17 .
#   # 多架构(buildx 自动注入 TARGETARCH):
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile-glib2.17 -t xtrabackup:base-glib-2.17 .
#
# 可用 ARG:
#   GH_PROXY        GitHub 下载代理前缀,默认空(直连)。例:https://gh.1102345.xyz/
#   PATCHELF_VERSION patchelf 版本,默认 0.19.1
#   TARGETARCH      buildx 自动注入(amd64/arm64),无需手动传
# registry.cn-hangzhou.aliyuncs.com/lpx03/xtrabackup:base-glib-2.17
FROM centos:7.9.2009

# buildx 多架构:TARGETARCH 由 buildx 自动注入(amd64/arm64)
ARG GH_PROXY=""
ARG PATCHELF_VERSION=0.19.1
ARG TARGETARCH

# ============================================================
# 全部 yum 源修复：统一使用南大镜像 mirror.nju.edu.cn
# CentOS 7 已 EOL，原 mirror.centos.org 不可用
# ============================================================
# Step A: 修复 CentOS-Base 源（禁 mirrorlist，用 centos-vault）
RUN sed -i \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^#baseurl=http://mirror.centos.org/centos/\$releasever|baseurl=https://mirror.nju.edu.cn/centos-vault/centos/\$releasever|g' \
        -e 's|^# baseurl=http://mirror.centos.org/centos/\$releasever|baseurl=https://mirror.nju.edu.cn/centos-vault/centos/\$releasever|g' \
        /etc/yum.repos.d/CentOS-Base.repo

# Step B: 安装 EPEL + SCL 仓库，然后修复这两个源
RUN yum install -y epel-release centos-release-scl && \
    sed -i \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^metalink=|#metalink=|g' \
        -e 's|^#baseurl=http://download.fedoraproject.org/pub/epel/\(.*\)|baseurl=https://mirror.nju.edu.cn/epel/\1|g' \
        -e 's|^# baseurl=http://download.fedoraproject.org/pub/epel/\(.*\)|baseurl=https://mirror.nju.edu.cn/epel/\1|g' \
        /etc/yum.repos.d/epel.repo /etc/yum.repos.d/epel-testing.repo && \
    sed -i \
        -e 's|^mirrorlist=|#mirrorlist=|g' \
        -e 's|^# *baseurl=http://mirror.centos.org/centos/7/sclo/|baseurl=https://mirror.nju.edu.cn/centos-vault/centos/7/sclo/|g' \
        /etc/yum.repos.d/CentOS-SCLo-scl-rh.repo \
        /etc/yum.repos.d/CentOS-SCLo-scl.repo

# ============================================================
# 安装全部编译依赖
# ============================================================
RUN yum install -y \
        autoconf \
        automake \
        bison \
        bzip2 \
        cmake3 \
        cyrus-sasl-devel \
        file \
        git \
        libaio \
        libaio-devel \
        libarchive \
        libcurl-devel \
        libev-devel \
        libgcrypt-devel \
        libgpg-error-devel \
        libicu-devel \
        libtool \
        libtirpc-devel \
        libudev-devel \
        libxml2-devel \
        lz4-devel \
        make \
        ncurses-devel \
        numactl-devel \
        openldap-devel \
        openssl-devel \
        patch \
        procps-ng-devel \
        readline-devel \
        vim-common \
        zlib-devel \
        zstd \
        devtoolset-11-gcc \
        devtoolset-11-gcc-c++ \
        devtoolset-11-binutils \
        devtoolset-11-annobin && \
    yum clean all && \
    rm -rf /var/cache/yum

# 安装新版 patchelf。
# yum/epel 源里的 patchelf 太老(0.x),对 xtrabackup 这种 256-notes 大 ELF
# 处理 --force-rpath / --set-soname 会静默失败,必须用新版。
# 架构映射:docker 用 amd64/arm64,patchelf 包名用 x86_64/aarch64
RUN set -e && \
    case "$TARGETARCH" in \
        amd64)  PE_ARCH=x86_64  ;; \
        arm64)  PE_ARCH=aarch64 ;; \
        *)      PE_ARCH="$TARGETARCH" ;; \
    esac && \
    PE_URL="${GH_PROXY}https://github.com/NixOS/patchelf/releases/download/${PATCHELF_VERSION}/patchelf-${PATCHELF_VERSION}-${PE_ARCH}.tar.gz" && \
    echo "==> 下载 patchelf: $PE_URL" && \
    curl -sSL -o /tmp/patchelf.tar.gz "$PE_URL" && \
    tar -xzf /tmp/patchelf.tar.gz -C /tmp && \
    cp /tmp/bin/patchelf /usr/local/bin/patchelf && \
    chmod +x /usr/local/bin/patchelf && \
    rm -rf /tmp/patchelf* && \
    patchelf --version

# cmake 软链 -> cmake3（兼容构建脚本直接调 cmake）
RUN ln -sf /usr/bin/cmake3 /usr/local/bin/cmake

# 全局启用 devtoolset-11 GCC 11.2.1
RUN echo 'source /opt/rh/devtoolset-11/enable' > /etc/profile.d/devtoolset-11.sh && \
    echo 'source /opt/rh/devtoolset-11/enable' >> /etc/bashrc

ENV CC=/opt/rh/devtoolset-11/root/usr/bin/gcc \
    CXX=/opt/rh/devtoolset-11/root/usr/bin/g++ \
    FC=/opt/rh/devtoolset-11/root/usr/bin/gfortran

# CentOS 7 glibc 版本
RUN ldd --version | head -1
